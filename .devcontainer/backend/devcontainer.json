{
  "name": "portfolio-backend",

  // ルートの compose.yaml の backend サービスを開発環境として使う
  // （.devcontainer/backend/ から見て 2 階層上がリポジトリルート）
  "dockerComposeFile": ["../../compose.yaml"],
  "service": "backend",

  // リポジトリ全体を /workspace にマウントし、作業ディレクトリは backend/
  "workspaceFolder": "/workspace/backend",

  // Go API サーバのポートを自動転送（ホストの http://localhost:8080）
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Go API Server",
      "onAutoForward": "notify"
    }
  },

  // workspaceFolder が /workspace/backend のため、スクリプトは絶対パスで指定する
  "postCreateCommand": "bash /workspace/.devcontainer/backend/post_create.sh",

  // Dockerfile と揃えて dev ユーザで動かす
  "remoteUser": "dev",

  // macOS では uid を書き換えない（既定 true だと dev が 1000→501 に変わり、
  // named volume(gomodcache, uid 1000) と所有者が食い違う）
  "updateRemoteUserUID": false,

  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go"
      ],
      "settings": {
        "go.useLanguageServer": true,
        "go.toolsManagement.checkForUpdates": "off",
        "editor.formatOnSave": true,
        "[go]": {
          "editor.defaultFormatter": "golang.go"
        }
      }
    }
  }
}
